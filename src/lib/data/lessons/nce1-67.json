		},
		{
			"i": 4,
			"start": 17.79,
			"end": 21.75,
			"en": "Hello. Were you at the butcher's?",
			"zh": "你好。你刚才在肉店吗？"
		},
		{
			"i": 5,
			"start": 21.9,
			"end": 23.74,
			"en": "Yes, I was.",
			"zh": "是的，我在那里。"
		},
		{
			"i": 6,
			"start": 23.89,
			"end": 27.26,
			"en": "Were you at the butcher's, too?",
			"zh": "你也在肉店吗？"
