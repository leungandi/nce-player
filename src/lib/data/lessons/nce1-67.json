		{
			"i": 8,
			"start": 30.53,
			"end": 34.14,
			"en": "I was at the greengrocer's.",
			"zh": "我在蔬菜店。"
		},
		{
			"i": 9,
			"start": 34.29,
			"end": 37.03,
			"en": "How's Jimmy today?",
			"zh": "吉米今天怎么样？"
		},
		{
			"i": 10,
			"start": 37.18,
			"end": 41.02,
			"en": "He's very well, thank you.",
			"zh": "他很好，谢谢你。"
		},
		{
			"i": 11,
			"start": 41.17,
			"end": 45.62,
			"en": "Was he absent from school last week?",
			"zh": "他上周没去上学吗？"
		},
		{
			"i": 12,
			"start": 45.77,
			"end": 48.13,
			"en": "Yes, he was.",
			"zh": "是的，他没去。"
		},
		{
			"i": 13,
			"start": 48.28,
			"end": 55.78,
			"en": "He was absent on Monday, Tuesday, Wednesday and Thursday.",
			"zh": "他周一、周二、周三和周四都没去。"
		},
		{
			"i": 14,
			"start": 55.93,
			"end": 59.43,
			"en": "How are you all keeping?",
			"zh": "你们都好吗？"
		},
		{
			"i": 15,
			"start": 59.58,
			"end": 62.25,
			"en": "Very well, thank you.",
			"zh": "我们都很好，谢谢。"
		},
		{
			"i": 16,
			"start": 62.4,
			"end": 67.34,
			"en": "We're going to spend three days in the country!",
			"zh": "我们要去乡下待三天！"
		},
		{
			"i": 17,
			"start": 67.49,
			"end": 73.28,
			"en": "We're going to stay at my mother's for the weekend.",
			"zh": "这个周末我们要待在我妈妈家。"
		},
		{
			"i": 18,
			"start": 73.43,
			"end": 78.84,
