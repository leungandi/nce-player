		{
			"i": 9,
			"start": 33.81,
			"end": 35.9,
			"en": "He's still here.",
			"zh": "他还在这儿。"
		},
		{
			"i": 10,
			"start": 36.05,
			"end": 39.67,
			"en": "He's going to move tomorrow.",
			"zh": "他明天就要搬家了。"
