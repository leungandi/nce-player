		{
			"i": 20,
			"start": 79.71,
			"end": 82.94,
			"en": "Yes, I will.",
			"zh": "是的，我会的。"
		},
		{
			"i": 21,
			"start": 83.09,
			"end": 87.68,
			"en": "Please give him my regards.",
			"zh": "请代我向他问好。"
		},
		{
			"i": 22,
			"start": 87.83,
			"end": 94.34,
			"en": "Poor Ian! He didn't want to leave this house.",
			"zh": "可怜的伊恩！他不想离开这所房子。"
