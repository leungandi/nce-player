		{
			"i": 15,
			"start": 54.57,
			"end": 58.02,
			"en": "He's a very nice person.",
			"zh": "他是个很好的人。"
		},
		{
			"i": 16,
			"start": 58.17,
			"end": 62.06,
			"en": "We'll all miss him.",
			"zh": "我们都会想念他的。"
		},
		{
			"i": 17,
			"start": 62.21,
			"end": 67.39,
			"en": "When will the new people move into this house?",
			"zh": "新住户什么时候搬进这所房子？"
		},
		{
			"i": 18,
			"start": 67.54,
			"end": 74.07,
			"en": "I think that they'll move in the day after tomorrow.",
			"zh": "我想他们会在后天搬进来。"
		},
		{
			"i": 19,
			"start": 74.22,
			"end": 79.56,
			"en": "Will you see Ian today, Jenny?",
			"zh": "珍妮，你今天会见到伊恩吗？"
