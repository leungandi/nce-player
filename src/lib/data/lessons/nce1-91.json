			"i": 12,
			"start": 44.12,
			"end": 47.68,
			"en": "No. Tomorrow afternoon.",
			"zh": "不，明天下午。"
		},
		{
			"i": 13,
			"start": 47.83,
			"end": 49.74,
			"en": "I'll miss him.",
			"zh": "我会想念他的。"
		},
		{
			"i": 14,
			"start": 49.89,
			"end": 54.42,
			"en": "He has always been a good neighbour.",
			"zh": "他一直是个好邻居。"
