		{
			"i": 5,
			"start": 21.25,
			"end": 23.06,
			"en": "Yes, he has.",
			"zh": "是的，他卖了。"
		},
		{
			"i": 6,
			"start": 23.21,
			"end": 26.77,
			"en": "He sold it last week.",
			"zh": "他上周卖的。"
		},
		{
			"i": 7,
			"start": 26.92,
			"end": 31.3,
			"en": "Has he moved to his new house yet?",
			"zh": "他搬到新家了吗？"
		},
		{
			"i": 8,
			"start": 31.45,
			"end": 33.66,
			"en": "No, not yet.",
			"zh": "不，还没有。"
