	"lines": [
		{
			"i": 0,
			"start": 9.77,
			"end": 15.76,
			"en": "Why did the writer complain to the people behind him?",
			"zh": "作者为什么要向他身后的人抱怨？"
		},
		{
			"i": 1,
			"start": 15.91,
			"end": 19.24,
			"en": "Last week I went to the theatre.",
			"zh": "上周我去了剧院。"
		},
		{
			"i": 2,
			"start": 19.39,
			"end": 21.92,
			"en": "I had a very good seat.",
			"zh": "我有一个很好的座位。"
		},
		{
			"i": 3,
			"start": 22.07,
			"end": 24.95,
			"en": "The play was very interesting.",
			"zh": "戏很有趣。"
		},
		{
			"i": 4,
			"start": 25.1,
			"end": 27.28,
			"en": "I did not enjoy it.",
			"zh": "我却没有享受到乐趣。"
		},
		{
			"i": 5,
			"start": 27.43,
			"end": 31.81,
			"en": "A young man and a young woman were sitting behind me.",
			"zh": "一对年轻的男女坐在我身后。"
		},
		{
			"i": 6,
			"start": 31.96,
			"end": 34.44,
			"en": "They were talking loudly.",
			"zh": "他们大声地说着话。"
		},
		{
			"i": 7,
			"start": 34.59,
			"end": 37.26,
			"en": "I got very angry.",
			"zh": "我非常生气。"
		},
		{
			"i": 8,
			"start": 37.41,
			"end": 40.49,
			"en": "I could not hear the actors.",
			"zh": "我听不见演员的讲话。"
		},
		{
			"i": 9,
			"start": 40.64,
			"end": 42.65,
			"en": "I turned round.",
			"zh": "我转过身。"
		},
		{
			"i": 10,
			"start": 42.8,
			"end": 47.12,
			"en": "I looked at the man and the woman angrily.",
			"zh": "我怒气冲冲地看着那一男一女。"
		},
		{
			"i": 11,
			"start": 47.27,
			"end": 50.54,
			"en": "They did not pay any attention.",
			"zh": "他们却不理不睬。"
		},
		{
			"i": 12,
			"start": 50.69,
			"end": 54.83,
			"en": "In the end, I could not bear it.",
			"zh": "最后，我忍不住了。"
		},
		{
			"i": 13,
			"start": 54.98,
			"end": 57.6,
			"en": "I turned round again.",
			"zh": "我又转过身去。"
		},
		{
			"i": 14,
			"start": 57.75,
			"end": 63.3,
			"en": "'I can't hear a word!' I said angrily.",
			"zh": "“我一个字也听不见了！”我生气地说。"
		},
		{
			"i": 15,
			"start": 63.45,
			"end": 66.12,
			"en": "'It's none of your business,'",
			"zh": "“不关你的事，”"
		},
		{
			"i": 16,
			"start": 66.27,
			"end": 68.85,
			"en": "the young man said rudely.",
			"zh": "那个年轻人粗鲁地说。"
		},
		{
			"i": 17,
			"start": 69,
			"end": 73,
			"en": "'This is a private conversation!'",
			"zh": "“这是私人谈话！”"
		}
	]
