		{
			"i": 9,
			"start": 35.39,
			"end": 39.068,
			"en": "It's over there, behind the teapot.",
			"zh": "它在那边，茶壶后面。"
		},
		{
			"i": 10,
			"start": 40.99,
			"end": 42.255,
			"en": "Can you see it?",
			"zh": "你能看到吗？"
		},
		{
			"i": 11,
			"start": 43.56,
			"end": 49.102,
			"en": "I can see the teapot, but I can't see the tea.",
			"zh": "我能看到茶壶，但我看不到茶。"
		},
		{
			"i": 12,
			"start": 49.73,
			"end": 50.999,
			"en": "There it is!",
			"zh": "它在那儿！"
		},
		{
			"i": 13,
			"start": 51.35,
			"end": 53.003,
			"en": "It's in front of you!",
			"zh": "就在你面前！"
		},
		{
			"i": 14,
			"start": 53.56,
			"end": 57.49,
			"en": "Ah yes, I can see it now.",
			"zh": "啊，是的，我现在看到了。"
		},
		{
			"i": 15,
			"start": 58.79,
			"end": 60.383,
			"en": "Where are the cups?",
			"zh": "杯子在哪里？"
		},
		{
			"i": 16,
			"start": 61.23,
			"end": 63.468,
			"en": "There are some in the cupboard.",
			"zh": "橱柜里有一些。"
		},
		{
			"i": 17,
			"start": 64.1,
			"end": 65.632,
			"en": "Can you find them?",
			"zh": "你能找到它们吗？"
