		{
			"i": 2,
			"start": 5.71,
			"end": 9.937,
			"en": "Listen to the tape then answer this question.",
			"zh": "听录音，然后回答问题。"
		},
		{
			"i": 3,
			"start": 11.33,
			"end": 16.257,
			"en": "How do you know Sam doesn't make the tea very often?",
			"zh": "你怎么知道山姆不经常泡茶？"
		},
		{
			"i": 4,
			"start": 18.21,
			"end": 20.782,
			"en": "Can you make the tea, Sam?",
			"zh": "山姆，你会泡茶吗？"
		},
		{
			"i": 5,
			"start": 22.14,
			"end": 25.397,
			"en": "Yes, of course I can, Penny.",
			"zh": "是的，我当然会，潘妮。"
		},
		{
			"i": 6,
			"start": 27.3,
			"end": 29.934,
			"en": "Is there any water in this kettle?",
			"zh": "这个水壶里有水吗？"
		},
		{
			"i": 7,
			"start": 31.01,
			"end": 32.682,
			"en": "Yes, there is.",
			"zh": "是的，有水。"
		},
		{
			"i": 8,
			"start": 33.61,
			"end": 34.871,
			"en": "Where's the tea?",
			"zh": "茶在哪里？"
