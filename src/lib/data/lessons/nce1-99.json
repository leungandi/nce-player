		{
			"i": 8,
			"start": 26.46,
			"end": 27.645,
			"en": "Yes, I have.",
			"zh": "是的，我摔伤了。"
		},
		{
			"i": 9,
			"start": 28.48,
			"end": 31.391,
			"en": "I think that I've hurt my back.",
			"zh": "我想我伤了背。"
		},
		{
			"i": 10,
			"start": 32.54,
			"end": 34.688,
			"en": "Try and stand up.",
			"zh": "试试站起来。"
