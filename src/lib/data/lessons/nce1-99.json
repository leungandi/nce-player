			"start": 37.45,
			"end": 38.037,
			"en": "Here.",
			"zh": "来。"
		},
		{
			"i": 13,
			"start": 38.53,
			"end": 40.123,
			"en": "Let me help you.",
			"zh": "我来帮你。"
