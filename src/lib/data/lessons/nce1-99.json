		{
			"i": 5,
			"start": 17.05,
			"end": 19.316,
			"en": "What's the matter, Andy?",
			"zh": "怎么了，安迪？"
		},
		{
			"i": 6,
			"start": 20.06,
			"end": 23.113,
			"en": "I slipped and fell downstairs.",
			"zh": "我滑了一下，从楼上摔下来了。"
		},
		{
			"i": 7,
			"start": 23.62,
			"end": 25.861,
			"en": "Have you hurt yourself?",
			"zh": "你摔伤了吗？"
