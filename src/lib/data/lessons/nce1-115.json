			"zh": "什么都没有。"
		},
		{
			"i": 13,
			"start": 45.78,
			"end": 49.07,
			"en": "Let's try the back door.",
			"zh": "我们试试后门吧。"
		},
		{
			"i": 14,
			"start": 49.22,
			"end": 53.07,
			"en": "Look! Everyone's in the garden.",
			"zh": "看！大家都在花园里。"
		},
		{
			"i": 15,
			"start": 53.22,
			"end": 57.16,
			"en": "Hello, Helen. Hello, Jim."
		},
		{
			"i": 16,
			"start": 57.31,
			"end": 61.21,
			"en": "Everybody wants to have lunch in the garden.",
			"zh": "大家都想在花园里吃午饭。"
		},
		{
			"i": 17,
			"start": 61.36,
			"end": 64.76,
			"en": "It's nice and warm out here.",
			"zh": "这里又好又暖和。"
		},
		{
			"i": 18,
			"start": 64.91,
			"end": 68.58,
			"en": "Come and have something to drink.",
			"zh": "来喝点什么吧。"
		},
		{
			"i": 19,
			"start": 68.73,
			"end": 70.62,
			"en": "Thanks, Carol.",
			"zh": "谢谢，卡罗尔。"
		},
		{
			"i": 20,
			"start": 70.77,
			"end": 74.43,
			"en": "May I have a glass of beer please?",
			"zh": "请给我一杯啤酒好吗？"
		},
		{
			"i": 21,
			"start": 74.58,
			"end": 75.57,
			"en": "Beer?",
			"zh": "啤酒？"
