		{
			"i": 22,
			"start": 75.72,
			"end": 77.72,
			"en": "There's none left.",
			"zh": "没剩下了。"
		},
		{
			"i": 23,
			"start": 77.87,
			"end": 80.89,
			"en": "You can have some lemonade.",
			"zh": "你可以喝些柠檬水。"
