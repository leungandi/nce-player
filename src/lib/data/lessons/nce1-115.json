		{
			"i": 26,
			"start": 84.71,
			"end": 86.44,
			"en": "She's only joking.",
			"zh": "她只是开玩笑。"
		},
		{
			"i": 27,
			"start": 86.59,
			"end": 90.59,
			"en": "Have some beer!",
			"zh": "喝点啤酒！"
		}
