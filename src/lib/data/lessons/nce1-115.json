		{
			"i": 4,
			"start": 18.07,
			"end": 21.41,
			"en": "Isn't there anyone at home?",
			"zh": "家里没人吗？"
		},
		{
			"i": 5,
			"start": 21.56,
			"end": 24.46,
			"en": "I'll knock again, Helen.",
			"zh": "海伦，我再敲一次。"
		},
		{
			"i": 6,
			"start": 24.61,
			"end": 27.45,
			"en": "Everything's very quiet.",
			"zh": "一切都很安静。"
		},
		{
			"i": 7,
			"start": 27.6,
			"end": 30.75,
			"en": "I'm sure there's no one at home.",
			"zh": "我确信家里没人。"
		},
		{
			"i": 8,
			"start": 30.9,
			"end": 33.46,
			"en": "But that's impossible.",
			"zh": "但那不可能。"
		},
		{
			"i": 9,
			"start": 33.61,
			"end": 37.65,
			"en": "Carol and Tom invited us to lunch.",
			"zh": "卡罗尔和汤姆邀请我们吃午饭。"
		},
		{
			"i": 10,
			"start": 37.8,
			"end": 40.55,
			"en": "Look through the window.",
			"zh": "看看窗户。"
